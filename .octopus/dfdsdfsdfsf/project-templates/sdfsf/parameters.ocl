parameter "k8s_TargetTag" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Target tag of the Kubernetes clusters to deploy to. Defaults to kubernetes, so tag your cluster targets with kubernetes or change this. Works with Kubernetes agent and Kubernetes API targets on any cloud or on-premises."
    label = "Kubernetes target tag"

    value "kubernetes" {}
}

parameter "k8s_WorkerPool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = "Worker pool that runs the steps for Kubernetes API targets. Kubernetes agent targets run the steps in the cluster."
    label = "Worker pool"
}

parameter "k8s_DevelopmentEnvironments" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments this project uses for development deployments. Choose one or more."
    label = "Development environments"
}

parameter "k8s_TestEnvironments" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments this project uses for test deployments. Choose one or more."
    label = "Test environments"
}

parameter "k8s_StagingEnvironments" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments this project uses for staging deployments, before production. Choose one or more."
    label = "Staging environments"
}

parameter "k8s_ProductionEnvironments" {
    display_settings = {
        Octopus.ControlType = "Environments"
    }
    help_text = "Environments this project uses for production deployments. Choose one or more."
    label = "Production environments"
}

parameter "k8s_Namespace" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Kubernetes namespace to deploy into. The template creates it if it does not exist. Defaults to the environment name in lower case."
    label = "Namespace"

    value "#{Octopus.Environment.Name | ToLower}" {}
}

parameter "k8s_AppName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Name for the Deployment, Service and Ingress. Lower case letters, numbers and hyphens only. Defaults to the project slug."
    label = "Workload name"

    value "#{Octopus.Project.Slug}" {}
}

parameter "k8s_ImageName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Container image without the tag, including the registry, for example ghcr.io/acme/orders. Defaults to a public NGINX sample image that listens on port 8080, so the template deploys something on the first run. Replace it with your own image."
    label = "Container image"

    value "docker.io/nginxinc/nginx-unprivileged" {}
}

parameter "k8s_ImageTag" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Image tag to deploy. Defaults to a tag of the sample image. When you switch to your own image, set this to #{Octopus.Release.Number} and create each release with the image tag as its version."
    label = "Image tag"

    value "stable-alpine" {}
}

parameter "k8s_ContainerPort" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Port the container listens on."
    label = "Container port"

    value "8080" {}
}

parameter "k8s_ServicePort" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Port the Service exposes inside the cluster. Traffic is forwarded to the container port."
    label = "Service port"

    value "80" {}
}

parameter "k8s_Replicas" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Number of pods to run."
    label = "Replicas"

    value "2" {}
}

parameter "k8s_CpuRequest" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            50m|0.05 CPU (tiny)
            100m|0.1 CPU (small)
            250m|0.25 CPU (medium)
            500m|0.5 CPU (large)
            1000m|1 CPU (extra large)
            EOT
    }
    help_text = "CPU reserved for each pod. Must be the same as or lower than the CPU limit."
    label = "CPU request"

    value "100m" {}
}

parameter "k8s_CpuLimit" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            250m|0.25 CPU (small)
            500m|0.5 CPU (medium)
            1000m|1 CPU (large)
            2000m|2 CPU (extra large)
            EOT
    }
    help_text = "Maximum CPU each pod can use. Must be the same as or higher than the CPU request."
    label = "CPU limit"

    value "500m" {}
}

parameter "k8s_MemoryRequest" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            64Mi|64 MiB (tiny)
            128Mi|128 MiB (small)
            256Mi|256 MiB (medium)
            512Mi|512 MiB (large)
            1Gi|1 GiB (extra large)
            EOT
    }
    help_text = "Memory reserved for each pod. Must be the same as or lower than the memory limit."
    label = "Memory request"

    value "128Mi" {}
}

parameter "k8s_MemoryLimit" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            128Mi|128 MiB (small)
            256Mi|256 MiB (medium)
            512Mi|512 MiB (large)
            1Gi|1 GiB (extra large)
            2Gi|2 GiB (double extra large)
            EOT
    }
    help_text = "Maximum memory each pod can use. If a pod goes over this, Kubernetes restarts it. Must be the same as or higher than the memory request."
    label = "Memory limit"

    value "512Mi" {}
}

parameter "k8s_DeployIngress" {
    display_settings = {
        Octopus.ControlType = "Checkbox"
    }
    help_text = "Tick to deploy an Ingress for this workload. Leave unticked for internal services."
    label = "Deploy Ingress"

    value "False" {}
}

parameter "k8s_IngressHost" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Host name for the Ingress, for example orders.example.com. Leave as any to accept traffic for any host name. Used only when Deploy Ingress is ticked."
    label = "Ingress host name"

    value "any" {}
}

parameter "k8s_IngressClassName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Ingress class to use, for example nginx. Leave as default to use the cluster's default Ingress class. Used only when Deploy Ingress is ticked."
    label = "Ingress class"

    value "default" {}
}

parameter "k8s_AdditionalManifests" {
    display_settings = {
        Octopus.ControlType = "MultiLineText"
    }
    help_text = "Optional extra Kubernetes YAML, such as ConfigMaps or a NetworkPolicy. Separate resources with ---. Applied to the namespace after the workload. Leave as none to skip this step."
    label = "Additional manifests"

    value "none" {}
}

parameter "k8s_DeploymentTimeout" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Seconds to wait for Kubernetes resources to become ready before the step fails."
    label = "Deployment timeout (seconds)"

    value "180" {}
}