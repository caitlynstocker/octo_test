name = "Default Lifecycle"

phase "Development" {
    manual_environments = ["k8s_DevelopmentEnvironments"]
}

phase "Test" {
    manual_environments = ["k8s_TestEnvironments"]
}

phase "Staging" {
    manual_environments = ["k8s_StagingEnvironments"]
}

phase "Production" {
    manual_environments = ["k8s_ProductionEnvironments"]
}

release_retention_policy {
    quantity_to_keep = 5
    type = "Count"
    unit = "Days"
}

tentacle_retention_policy {
    quantity_to_keep = 5
    type = "Count"
    unit = "Days"
}