name = "zddsfdxfg"
description = ""

parameter "k8s_TargetTag" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Target tag of the Kubernetes clusters to deploy to. Works with Kubernetes agent and Kubernetes API targets on any cloud or on-premises."
    label = "Kubernetes target tag"
}

parameter "k8s_WorkerPool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = "Worker pool that runs the steps for Kubernetes API targets. Kubernetes agent targets run the steps in the cluster."
    label = "Worker pool"
}

parameter "k8s_Namespace" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Kubernetes namespace to deploy into. Defaults to the environment name in lower case."
    label = "Namespace"

    value "#{Octopus.Environment.Slug}" {}
}

parameter "k8s_CreateNamespace" {
    display_settings = {
        Octopus.ControlType = "Checkbox"
    }
    help_text = "Tick to create the namespace if it doesn't exist. Untick if your namespaces are created some other way, or if the deployment target can't create namespaces."
    label = "Create namespace"

    value "True" {}
}

parameter "k8s_AppName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Name for the Deployment, Service and Ingress. Lower case letters, numbers and hyphens only. Defaults to the project slug. If the project already deploys resources with this name, this template replaces them."
    label = "Workload name"

    value "#{Octopus.Project.Slug}" {}
}

parameter "k8s_ImageName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Container image without the tag, including the registry, for example ghcr.io/acme/orders. The cluster must be able to pull this image."
    label = "Container image"
}

parameter "k8s_ImageTag" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Image tag to deploy. Defaults to the release number, so create each release with the image tag as its version. Tags can't contain a plus sign."
    label = "Image tag"
}

parameter "k8s_ContainerPort" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Port the container listens on."
    label = "Container port"
}

parameter "k8s_ServicePort" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Port the Service exposes inside the cluster. Traffic is forwarded to the container port."
    label = "Service port"
}

parameter "k8s_Replicas" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Number of pods to run."
    label = "Replicas"

    value "2" {}
}

parameter "k8s_CpuRequest" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            50m|0.05 CPU (tiny)
            100m|0.1 CPU (small)
            250m|0.25 CPU (medium)
            500m|0.5 CPU (large)
            1000m|1 CPU (extra large)
            EOT
    }
    help_text = "CPU reserved for each pod. Must be the same as or lower than the CPU limit."
    label = "CPU request"

    value "100m" {}
}

parameter "k8s_CpuLimit" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            250m|0.25 CPU (small)
            500m|0.5 CPU (medium)
            1000m|1 CPU (large)
            2000m|2 CPU (extra large)
            EOT
    }
    help_text = "Maximum CPU each pod can use. Must be the same as or higher than the CPU request."
    label = "CPU limit"

    value "500m" {}
}

parameter "k8s_MemoryRequest" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            64Mi|64 MiB (tiny)
            128Mi|128 MiB (small)
            256Mi|256 MiB (medium)
            512Mi|512 MiB (large)
            1Gi|1 GiB (extra large)
            EOT
    }
    help_text = "Memory reserved for each pod. Must be the same as or lower than the memory limit."
    label = "Memory request"

    value "128Mi" {}
}

parameter "k8s_MemoryLimit" {
    display_settings = {
        Octopus.ControlType = "Select"
        Octopus.SelectOptions = <<-EOT
            128Mi|128 MiB (small)
            256Mi|256 MiB (medium)
            512Mi|512 MiB (large)
            1Gi|1 GiB (extra large)
            2Gi|2 GiB (double extra large)
            EOT
    }
    help_text = "Maximum memory each pod can use. If a pod goes over this, Kubernetes restarts it. Must be the same as or higher than the memory request."
    label = "Memory limit"

    value "512Mi" {}
}

parameter "k8s_DeployIngress" {
    display_settings = {
        Octopus.ControlType = "Checkbox"
    }
    help_text = "Tick to deploy an Ingress for this workload. Leave unticked for internal services."
    label = "Deploy Ingress"

    value "False" {}
}

parameter "k8s_IngressHost" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Host name for the Ingress, for example orders.example.com. Leave as any to accept traffic for any host name. Used only when Deploy Ingress is ticked."
    label = "Ingress host name"

    value "any" {}
}

parameter "k8s_IngressClassName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Ingress class to use, for example nginx. Leave as default to use the cluster's default Ingress class. Used only when Deploy Ingress is ticked."
    label = "Ingress class"

    value "default" {}
}

parameter "k8s_AdditionalManifests" {
    display_settings = {
        Octopus.ControlType = "MultiLineText"
    }
    help_text = "Optional extra Kubernetes YAML, such as ConfigMaps or a NetworkPolicy. Separate resources with ---. Applied to the namespace after the workload. Leave as none to skip this step."
    label = "Additional manifests"

    value "none" {}
}

parameter "k8s_DeploymentTimeout" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Seconds to wait for Kubernetes resources to become ready before the step fails."
    label = "Deployment timeout (seconds)"

    value "180" {}
}

step "create-namespace" {
    condition = "Variable"
    name = "Create namespace"
    properties = {
        Octopus.Action.TargetRoles = "#{k8s_TargetTag}"
        Octopus.Step.ConditionVariableExpression = "#{k8s_CreateNamespace}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "#{k8s_DeploymentTimeout}"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: v1
                kind: Namespace
                metadata:
                  name: #{k8s_Namespace}
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = "#{k8s_WorkerPool}"
    }
}

step "deploy-workload" {
    name = "Deploy workload"
    properties = {
        Octopus.Action.TargetRoles = "#{k8s_TargetTag}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "#{k8s_DeploymentTimeout}"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: #{k8s_AppName}
                  labels:
                    app.kubernetes.io/name: #{k8s_AppName}
                    app.kubernetes.io/version: "#{k8s_ImageTag}"
                    app.kubernetes.io/managed-by: octopus-deploy
                spec:
                  replicas: #{k8s_Replicas}
                  selector:
                    matchLabels:
                      app.kubernetes.io/name: #{k8s_AppName}
                  template:
                    metadata:
                      labels:
                        app.kubernetes.io/name: #{k8s_AppName}
                        app.kubernetes.io/version: "#{k8s_ImageTag}"
                    spec:
                      containers:
                        - name: #{k8s_AppName}
                          image: #{k8s_ImageName}:#{k8s_ImageTag}
                          ports:
                            - name: http
                              containerPort: #{k8s_ContainerPort}
                          resources:
                            requests:
                              cpu: "#{k8s_CpuRequest}"
                              memory: "#{k8s_MemoryRequest}"
                            limits:
                              cpu: "#{k8s_CpuLimit}"
                              memory: "#{k8s_MemoryLimit}"
                ---
                apiVersion: v1
                kind: Service
                metadata:
                  name: #{k8s_AppName}
                  labels:
                    app.kubernetes.io/name: #{k8s_AppName}
                    app.kubernetes.io/managed-by: octopus-deploy
                spec:
                  type: ClusterIP
                  selector:
                    app.kubernetes.io/name: #{k8s_AppName}
                  ports:
                    - name: http
                      port: #{k8s_ServicePort}
                      targetPort: http
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{k8s_Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = "#{k8s_WorkerPool}"
    }
}

step "deploy-ingress" {
    condition = "Variable"
    name = "Deploy Ingress"
    properties = {
        Octopus.Action.TargetRoles = "#{k8s_TargetTag}"
        Octopus.Step.ConditionVariableExpression = "#{k8s_DeployIngress}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "#{k8s_DeploymentTimeout}"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: networking.k8s.io/v1
                kind: Ingress
                metadata:
                  name: #{k8s_AppName}
                  labels:
                    app.kubernetes.io/name: #{k8s_AppName}
                    app.kubernetes.io/managed-by: octopus-deploy
                spec:
                #{if k8s_IngressClassName != "default"}  ingressClassName: #{k8s_IngressClassName}#{/if}
                  rules:
                    - http:
                        paths:
                          - path: /
                            pathType: Prefix
                            backend:
                              service:
                                name: #{k8s_AppName}
                                port:
                                  name: http
                #{if k8s_IngressHost != "any"}      host: #{k8s_IngressHost}#{/if}
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{k8s_Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = "#{k8s_WorkerPool}"
    }
}

step "apply-additional-manifests" {
    condition = "Variable"
    name = "Apply additional manifests"
    properties = {
        Octopus.Action.TargetRoles = "#{k8s_TargetTag}"
        Octopus.Step.ConditionVariableExpression = "#{if k8s_AdditionalManifests != \"none\"}True#{/if}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "#{k8s_DeploymentTimeout}"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = "#{k8s_AdditionalManifests}"
            Octopus.Action.KubernetesContainers.Namespace = "#{k8s_Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = "#{k8s_WorkerPool}"
    }
}